[user]
	name = Serhii Serdiuk
	email = 10415950+serhii-serdiuk@users.noreply.github.com
[credential]
	helper = store

[fetch]
	prune = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	autoSquash = true
[push]
	default = current

[core]
	; editor = kwrite
	editor = vim
[diff]
	; tool = meld
	tool = vimdiff
[merge]
	; tool = meld
	tool = vimdiff
	autoStash = true
[mergetool]
	keepBackup = false

[difftool "kommitdiff"]
	cmd = kommitdiff \"$LOCAL\" \"$REMOTE\"
[mergetool "kommitmerge"]
	cmd = kommitmerge \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
	trustExitCode = true

[gui]
	historybrowser = git dag
	editor = kwrite
	fontui = -family \"Noto Sans\" -size 11 -weight normal -slant roman -underline 0 -overstrike 0
	fontdiff = -family \"Fira Code\" -size 11 -weight normal -slant roman -underline 0 -overstrike 0
[cola]
	spellcheck = false
	startupmode = folder
	blameviewer = git gui blame
	fontdiff = Fira Code,10,-1,5,50,0,0,0,0,0,Regular
