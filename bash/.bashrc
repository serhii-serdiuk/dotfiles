# .bashrc

# Source global definitions for Fedora, for other distros it's done automatically
DISTRO=$(head -n 1 /etc/os-release | cut -d "\"" -f 2 | cut -d " " -f 1)
DISTRO=${DISTRO,,} && DISTRO=${DISTRO^}
if [[ $DISTRO == "Fedora" && -f /etc/bashrc ]]; then
    . /etc/bashrc
fi

shopt -s globstar

# Enable vi mode
#if [[ $- == *i* ]]; then  # check if current session is interactive
#    set -o vi
#fi

# Set some common vars
export EDITOR=vim
export LC_TIME=uk_UA.UTF-8

# Set history related vars
export HISTSIZE=-1
export HISTFILESIZE=-1
export HISTFILE=~/.bash_history
# export HISTTIMEFORMAT="[%F %T]  "
export HISTTIMEFORMAT=""
export HISTCONTROL=erasedups:ignorespace
export HISTIGNORE="ha:hc:hs:q:qq:v:vf:r:du:df:ls:ll:cd:..:pwd:zsh:git-branch"

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

export GTK_USE_PORTAL=1
export GDK_DEBUG=portals

# Add some user dirs to PATH
USER_PATH=$HOME/.local/bin:$HOME/.scripts:$HOME/.nvm/versions/node/v20.9.0/bin
if ! [[ "$PATH" =~ $USER_PATH ]]; then
    PATH="$PATH:$USER_PATH"
fi

# Enable bash completion
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# User specific aliases and functions
if [ -d ~/.shell-utils ]; then
    for file in ~/.shell-utils/*; do
        if [ -f "$file" ]; then
            . "$file"
        fi
    done
fi

# Set up fzf key bindings and fuzzy completion
if [[ $DISTRO == "Tuxedo" || $DISTRO == "Ubuntu" ]]; then
    [ -f ~/.fzf.bash ] && source ~/.fzf.bash
elif [ $DISTRO == "Fedora" ]; then
    eval "$(fzf --bash)"
fi

# Set fzf vars
export FZF_DEFAULT_OPTS='--bind alt-k:preview-page-up,alt-j:preview-page-down'

# TODO: leads to problem with sourcing of craftenv.sh
# export FZF_CTRL_T_OPTS='
#     --walker-skip .git,*.swp
#     --preview="bat --color=always --style=numbers --line-range=:500 {}"'

# export FZF_ALT_C_OPTS='
#     --walker-skip .git,*.swp
#     --preview="tree -a --gitignore -C {}"'


# Bind fzf file search to Ctrl-F
bind -x '"\C-f": "fzf-file-widget"'

# Bind fzf change directory to Ctrl-T
# Need to remove existing binding to Ctrl-T first, otherwise Ctrl-R will be broken for some reason
bind -r "\C-t"
bind '"\C-t": "\C-e\C-u`__fzf_cd__`\e\C-e\er \C-m\C-y"'

# Reset Alt-C binding to default value (optional)
bind '"\ec": capitalize-word'

# Enable fzf ** completion for additional commands
_fzf_setup_completion path v
_fzf_setup_completion dir pd tree ranger r
_fzf_setup_completion var env
_fzf_setup_completion alias alias
_fzf_setup_completion host ssh-copy-id
_fzf_setup_completion proc ps

# Add preview for fzf search results
_fzf_comprun() {
    local command=$1
    shift
    case "$command" in
        cd|pushd|pd|rmdir|tree|ranger|r)
            find . -type d | fzf --preview 'tree -a --gitignore -C {}' "$@" ;;
        env|export|unset)
            fzf --preview 'printenv {}' ;;
        alias|unalias)
            fzf --preview 'bash -c "source $HOME/.shell-utils/aliases.sh && alias {} | bat --color=always --style=numbers --language=sh"' "$@" ;;
        ps|kill|ssh|ssh-copy-id)
            fzf "$@" ;;
        *)
            fzf --preview 'bat --color=always --style=numbers --line-range=:500 {}' ;;
    esac
}

# Use powerline prompt
if [ -f $(which powerline-daemon) ]; then
    powerline-daemon -q
    POWERLINE_BASH_CONTINUATION=1
    POWERLINE_BASH_SELECT=1
    if [[ $DISTRO == "Tuxedo" || $DISTRO == "Ubuntu" ]]; then
        . /usr/share/powerline/bindings/bash/powerline.sh
    elif [ $DISTRO == "Fedora" ]; then
        . /usr/share/powerline/bash/powerline.sh
    fi
fi
# TODO: (ubuntu22.04, powerline installed via apt, bash)
# consider replacing lines above with the following /usr/share/powerline/integrations/powerline.sh
# might be available only when powerline installed via system package manager and not as python package

# Set Qt related vars
# export QT_SELECT=6

# Qt from installer
# QT6_DIR=/data/home/Workspace/Frameworks/Qt/6.6.2/gcc_64
# QT6_LIBS_DIR=$QT6_DIR/lib

# Qt in system path
# QT6_DIR=/usr/lib/x86_64-linux-gnu/qt6
# QT6_LIBS_DIR=/usr/lib/x86_64-linux-gnu

# export QT_PLUGIN_PATH=$QT6_DIR/plugins
# export QT_QPA_PLATFORM_PLUGIN_PATH=$QT_PLUGIN_PATH/platforms
# export QML2_IMPORT_PATH=$QT6_DIR/qml

# Set projects related vars
export PROJECTS_DIR=$HOME/Projects

# AUTOGENERATED (ADDED BY OTHER SCRIPTS) PART STARTS HERE

# Needed for running GUI apps inside container
if [ -n "$XAUTHORITY" ] && [ "$XAUTHORITY" != "$HOME/.Xauthority" ]; then
    cp -u $XAUTHORITY $HOME/.Xauthority
fi
